    {
      "num": 5,
      "text": "Select one career from any of the lists in requirements 1, 2, 3, or 4 and arrange to visit that professional at their workplace. Discuss with your counselor the following:",
      "subs": [
        {
          "letter": "a",
          "text": "Why did they choose their particular career?",
          "blocks": [
            {
              "type": "lines",
              "rows": 4
            }
          ]
        },
        {
          "letter": "b",
          "text": "What do they most like about their job?",
          "blocks": [
            {
              "type": "lines",
              "rows": 4
            }
          ]
        },
        {
          "letter": "c",
          "text": "What are their biggest challenges in doing their job?",
          "blocks": [
            {
              "type": "lines",
              "rows": 4
            }
          ]
        },
        {
          "letter": "d",
          "text": "Identify the tools/instruments that may be used in their jobs.",
          "blocks": [
            {
              "type": "lines",
              "rows": 4
            }
          ]
        },
        {
          "letter": "e",
          "text": "What has been the most surprising aspect of their career?",
          "blocks": [
            {
              "type": "lines",
              "rows": 4
            }
          ]
        },
        {
          "letter": "f",
          "text": "What continuing education requirements are required to maintain certification?",
          "blocks": [
            {
              "type": "lines",
              "rows": 4
            }
          ]
        }
      ]
    },
    {
      "num": 6,
      "text": "Discuss with your counselor your understanding of the meaning of the Physician's Oath.",
